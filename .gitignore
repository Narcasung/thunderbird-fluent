# Screenshot output from tools/capture.ps1 — regenerable, and captures
# mail content that should not be committed.
shots/
*.png

# Ad-hoc backups. Git makes these obsolete; keep them out.
.mica-bak/
*.bak
*.pre-*
*.orig

# Built add-on. tools/pack-extension.ps1 regenerates it from extension/,
# which is the source of truth; a zip in history would only ever go stale.
dist/

# The README screenshots are deliberate and reviewed; capture.ps1 output is not.
!screenshots/*.png
