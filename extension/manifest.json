{
  "manifest_version": 2,
  "name": "Thunderbird Fluent",
  "description": "The Fluent 2 theme for Thunderbird",
  "version": "1.0.1",
  "author": "Narcasung",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "64": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-fluent@narcasung",
      "strict_min_version": "128.0"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "experiment_apis": {
    "thunderbirdFluent": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["thunderbirdFluent"]],
        "script": "api.js",
        "events": ["startup"]
      }
    }
  }
}
